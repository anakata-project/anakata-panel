# Must match the running API origin. CORS allows this panel via FRONTEND_PANEL_URL
# (http://localhost:3001 locally). On Netlify, set NUXT_PUBLIC_API_BASE in the site env.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Empty = Marker.io widget off. Set the project id to show the feedback button.
NUXT_PUBLIC_MARKER_PROJECT_ID=

# Reverb is published on the API host port 8001. The PHP process uses 8080 inside the container.
NUXT_PUBLIC_REVERB_APP_KEY=anakata-local-key
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8001
NUXT_PUBLIC_REVERB_SCHEME=http

# Browser Reverb endpoint. The API container listens on 8080; compose publishes it as 8001.
NUXT_PUBLIC_REVERB_APP_KEY=anakata-local-key
NUXT_PUBLIC_REVERB_HOST=localhost
NUXT_PUBLIC_REVERB_PORT=8001
NUXT_PUBLIC_REVERB_SCHEME=http
