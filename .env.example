# Must match the running API origin. CORS allows this panel via FRONTEND_PANEL_URL
# (http://localhost:3001 locally). On Netlify, set NUXT_PUBLIC_API_BASE in the site env.
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Empty = Marker.io widget off. Set the project id to show the feedback button.
NUXT_PUBLIC_MARKER_PROJECT_ID=
